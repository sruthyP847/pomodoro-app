# Copy to .env and adjust as needed. Do not commit .env.
# These values are local-development defaults only — never real credentials.

# --- Postgres (consumed by docker-compose.yml) ---
POSTGRES_USER=pomme
POSTGRES_PASSWORD=pomme
POSTGRES_DB=pomme
# Host port mapped to the container's 5432. Change if 5432 is already in use.
POSTGRES_PORT=5432

# --- API ---
PORT=3001

# Connection string for Prisma. Must match the Postgres values above —
# postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:POSTGRES_PORT/POSTGRES_DB
# If you change any of those, change this too (it is not interpolated).
DATABASE_URL=postgresql://pomme:pomme@localhost:5432/pomme?schema=public

# --- Clerk (auth) ---
# Get both from the Clerk dashboard: API keys for your development instance.
# https://dashboard.clerk.com → your app → Configure → API keys

# Backend secret key — used by the API to verify session tokens.
# NEVER commit the real value and never expose it to the browser.
CLERK_SECRET_KEY=your_clerk_secret_key_here


# Frontend publishable key. The VITE_ prefix is what makes Vite expose it to
# client code — that is expected here; this key is safe to ship to the browser.
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
