// Prisma schema for Pomme.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(uuid())
  clerkUserId String     @unique
  email       String
  createdAt   DateTime   @default(now())
  sessions    Session[]
  gamePlans   GamePlan[] @relation("UserGamePlans")

  /// The plan the timer currently runs on. Nullable so a User row can exist
  /// before its default plan is created by the lazy sync.
  activeGamePlanId String?
  activeGamePlan   GamePlan? @relation("ActiveGamePlan", fields: [activeGamePlanId], references: [id])

  tasks Task[] @relation("UserTasks")

  /// The task the timer is currently working toward, if any.
  activeTaskId String?
  activeTask   Task?   @relation("ActiveTask", fields: [activeTaskId], references: [id])

  workBlocks WorkBlock[] @relation("UserWorkBlocks")

  /// The sitting currently in progress. Only this block is reachable; older
  /// open blocks stay open but unreferenced.
  activeWorkBlockId String?
  activeWorkBlock   WorkBlock? @relation("ActiveWorkBlock", fields: [activeWorkBlockId], references: [id])
}

/// A named, reusable set of timer durations.
model GamePlan {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation("UserGamePlans", fields: [userId], references: [id])
  name                    String
  workDurationMs          Int
  breakDurationMs         Int
  longBreakDurationMs     Int
  sessionsBeforeLongBreak Int
  createdAt               DateTime @default(now())

  /// Back-reference for the activeGamePlan relation.
  activeForUsers User[] @relation("ActiveGamePlan")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // "work" | "break" | "long_break"
  startedAt DateTime
  endedAt   DateTime?
  completed Boolean   @default(false)
  /// The phase's configured length, so pauses don't inflate it.
  /// startedAt/endedAt span wall-clock time and can include paused time.
  activeDurationMs Int

  /// The task this session counted toward, if one was active at the time.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  /// The sitting this session ran inside, if any. Null for plain and
  /// Quick-Start-plus-Task sessions run outside a block.
  workBlockId String?
  workBlock   WorkBlock? @relation(fields: [workBlockId], references: [id])
}

/// A unit of work the user is tracking sessions against.
model Task {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation("UserTasks", fields: [userId], references: [id])
  name             String
  estimatedMinutes Int
  completed        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  /// Sessions logged against this task. Actual time spent is always summed
  /// from these live, never stored on the task.
  sessions Session[]

  /// Back-reference for the activeTask relation.
  activeForUsers User[] @relation("ActiveTask")

  /// Blocks this task has been attached to, across all sittings.
  workBlocks WorkBlockTask[]
}

/// A named sitting that groups tasks and sessions. Entirely optional — the
/// standalone task flow works with no block at all.
model WorkBlock {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation("UserWorkBlocks", fields: [userId], references: [id])
  name      String
  startedAt DateTime
  /// Null means still open. Only Finish sets this.
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  tasks    WorkBlockTask[]
  sessions Session[]

  /// Back-reference for the activeWorkBlock relation.
  activeForUsers User[] @relation("ActiveWorkBlock")
}

/// Join row: a task can belong to many blocks over time, and progress is
/// always summed across every session regardless of which block it ran under.
model WorkBlockTask {
  id          String    @id @default(uuid())
  workBlockId String
  workBlock   WorkBlock @relation(fields: [workBlockId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([workBlockId, taskId])
}
